{
  "name": "@campus/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "node scripts/prisma.mjs generate --schema prisma/schema.prisma",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretypecheck": "node scripts/prisma.mjs generate --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/prisma.mjs generate --schema prisma/schema.prisma",
    "test": "jest --runInBand",
    "db:generate": "node scripts/prisma.mjs generate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/prisma.mjs migrate dev --schema prisma/schema.prisma",
    "db:deploy": "node scripts/prisma.mjs migrate deploy --schema prisma/schema.prisma",
    "db:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "db:studio": "node scripts/prisma.mjs studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
